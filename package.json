{
  "name": "techblog",
  "version": "1.0.0",
  "description": "Full Stack Technology Blog - MERN Stack",
  "private": true,
  "scripts": {
    "build": "npm run install:all && npm run build:client",
    "build:client": "cd client && npm run build",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install --include=dev",
    "install:all": "npm run install:server && npm run install:client",
    "start": "cd server && node src/index.js",
    "dev": "cd server && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["mern", "blog", "fullstack"],
  "author": "Tech Nova",
  "license": "MIT"
}
