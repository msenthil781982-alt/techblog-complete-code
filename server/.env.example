# ============================================
#   TechBlog Server - Environment Variables
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Replace with your MongoDB Atlas connection string or local URI (MONGO_URI or MONGO_URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/techblog?retryWrites=true&w=majority

# --- JWT Authentication ---
# Use a strong, random 256-bit secret in production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# --- Admin Seed Credentials (used by seed script only) ---
ADMIN_EMAIL=admin@techblog.com
ADMIN_PASSWORD=Admin@123456

# --- CORS ---
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# --- Cloudinary (for production image hosting) ---
# Leave blank to use local disk storage in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Resend Email Provider ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=TechBlog <onboarding@resend.dev>
